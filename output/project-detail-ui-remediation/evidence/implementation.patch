+                status="active" if index == 7 else "planning",
+                planned_start_date=timezone.localdate() + timedelta(days=index),
+            )
+        for code in ["02", "03", "04"]:
+            WBSNode.objects.create(
+                organization=self.organization,
+                project=self.project,
+                code=code,
+                title=code,
