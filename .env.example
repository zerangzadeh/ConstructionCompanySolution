# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-secure-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to True only when a trusted reverse proxy supplies X-Forwarded-Proto.
DJANGO_USE_X_FORWARDED_PROTO=False

# Production security settings
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_HSTS_PRELOAD=True

# Database backend: postgresql (target) or mssql (temporary rollback)
DB_ENGINE=postgresql
DB_NAME=construction_erp
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=5432
# Local development can use prefer. Production must explicitly use verify-full.
DB_SSLMODE=prefer
# Optional path to a trusted CA certificate when it is not in the system trust store.
DB_SSLROOTCERT=
DB_CONNECT_TIMEOUT=10

# Temporary Microsoft SQL Server rollback settings.
# Set DB_ENGINE=mssql, DB_PORT=1433, and uncomment the values below.
# DB_DRIVER=ODBC Driver 17 for SQL Server
# Local development only when SQL Server uses a self-signed certificate.
# Production must use Encrypt=yes with a trusted server certificate.
# DB_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=yes

# Optional services
REDIS_URL=redis://localhost:6379/0
