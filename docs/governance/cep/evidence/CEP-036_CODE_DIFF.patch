+        fixture = fixtures.IndexationTests()
+        fixture.setUp()
+        self.addCleanup(fixture.doCleanups)
+        before = type(fixture.contract).objects.values().get(pk=fixture.contract.pk)
+        codes = [
+            "indexation_rules.manage",
