+        )
+        cls.start = datetime(2026, 2, 1, 8, tzinfo=ZoneInfo("Asia/Tehran"))
+        cls.attendance = capture_attendance(
+            organization=cls.organization,
+            actor=cls.user,
+            employee=cls.employee,
+            calendar=cls.calendar,
+            project=cls.project,
