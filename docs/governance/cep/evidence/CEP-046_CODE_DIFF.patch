+{% extends "base.html" %}
+{% block title %}{{ page_title }}{% endblock %}
+{% block content %}
+<div data-workspace-id="WS-19" class="max-w-4xl">
+{% include "components/page_header.html" with page_eyebrow="مدیریت گردش‌کارها" page_title=page_title only %}
+<a class="erp-btn erp-btn--secondary mt-4" href="{% url 'workflows:definition_list' %}">فهرست تعریف‌ها</a>
+{% if version %}<p class="mt-4 text-sm">{{ version.definition.name }} · نسخه {{ version.version_number }} · {{ version.get_status_display }}</p>{% endif %}
+<form method="post" class="erp-surface mt-5 space-y-5 rounded-xl p-5">
+{% csrf_token %}{% include "components/form_errors.html" with form=form only %}
+{% for field in form %}{% include "components/form_field.html" with field=field only %}{% endfor %}
