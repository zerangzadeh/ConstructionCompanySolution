+    def _claim(self, case):
+        task = WorkItem.objects.get(instance__subject_id=case.pk)
+        claim_work_item(
+            actor=self.owner,
+            organization=self.organization,
+            work_item_id=task.pk,
+            idempotency_key="claim",
+        )
+        task.refresh_from_db()
+        return task
