+{% extends "base.html" %}
+{% load erp_format %}
+{% block title %}سوابق استخدام من | بنیرا{% endblock %}
+{% block content %}
+<section class="mx-auto max-w-4xl" dir="rtl">
+  {% include "workforce/_ess_navigation.html" %}
+  <header class="erp-surface rounded-2xl p-5 sm:p-6">
+    <p class="text-xs font-bold text-blue-700">خدمات کارکنان</p>
+    <h1 class="mt-2 text-2xl font-black text-slate-950">قرارداد و احکام استخدام من</h1>
+    <p class="mt-3 text-sm text-slate-600">سوابق مؤثر و تاریخی فقط از رابطه کاری و نسخه‌های مجاز اسناد خوانده می‌شوند.</p>
+  </header>
+  {% if history_error %}
+    <p class="erp-surface mt-5 rounded-2xl p-5" role="alert">دریافت سوابق استخدام ممکن نشد. دوباره تلاش کنید.</p>
+  {% elif history.document_state == "unavailable" %}
+    <p class="erp-surface mt-5 rounded-2xl p-5" role="status">منبع اسناد برای حساب شما در دسترس نیست.</p>
+  {% else %}
+    <div class="mt-5 grid gap-4">
+      {% for row in history.rows %}
+      <article class="erp-surface rounded-2xl p-5 sm:p-6">
+        <div class="flex flex-wrap items-center justify-between gap-3">
+          <h2 class="text-lg font-bold">{{ row.kind_label }}</h2>
+          <span class="rounded-full bg-slate-100 px-3 py-1 text-sm">{{ row.status_label }}</span>
+        </div>
+        <dl class="mt-4 grid gap-4 sm:grid-cols-3">
+          <div><dt class="text-xs text-slate-500">نسخه منبع</dt><dd class="mt-1 font-bold">{{ row.version|erp_number }}</dd></div>
+          <div><dt class="text-xs text-slate-500">شروع اثر</dt><dd class="mt-1 font-bold">{{ row.effective_from|jalali_date }}</dd></div>
+          <div><dt class="text-xs text-slate-500">پایان اثر ثبت‌شده</dt><dd class="mt-1 font-bold">{{ row.effective_to|jalali_date|default:"ثبت نشده" }}</dd></div>
+        </dl>
+        {% if row.can_download %}
+          <a class="mt-5 inline-flex rounded-xl bg-blue-700 px-4 py-2 font-bold text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" href="{% url 'documents:employee-version-download' row.document_id row.document_version_id %}">دریافت نسخه مجاز سند</a>
+        {% else %}<p class="mt-4 text-sm text-slate-600" role="status">دریافت این نسخه سند در دسترس نیست.</p>{% endif %}
+      </article>
+      {% empty %}<p class="erp-surface rounded-2xl p-5" role="status">سابقه استخدام مجازی برای نمایش موجود نیست.</p>{% endfor %}
+    </div>
+  {% endif %}
+</section>
+{% endblock %}
