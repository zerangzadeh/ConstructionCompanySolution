@@ -0,0 +1,23 @@
+{% load erp_format %}
+<article class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
+  <h3 class="font-bold text-slate-900">{{ card.result.run.metric_version.definition.persian_name }}</h3>
+  <p class="mt-1 text-sm text-slate-600">{% if card.result.project %}{{ card.result.project.name }}{% else %}دامنه ثبت‌شده شرکت / سبد{% endif %}</p>
+  <dl class="mt-3 space-y-2 text-sm">
+    <div><dt class="inline text-slate-500">وضعیت: </dt><dd class="inline">{{ card.result.get_freshness_display }}{% if not card.reviewed %} · در انتظار بررسی مستقل{% endif %}</dd></div>
+    <div><dt class="inline text-slate-500">پوشش: </dt><dd class="inline">{% if card.result.coverage.complete %}کامل طبق منبع{% else %}ناقص؛ مقدار قابل اتکا نیست{% endif %}</dd></div>
+    <div><dt class="inline text-slate-500">زمان مبنای منبع: </dt><dd class="inline">{{ card.result.as_of|jalali_datetime }}</dd></div>
+    <div><dt class="inline text-slate-500">ثبت شواهد: </dt><dd class="inline">{{ card.result.created_at|jalali_datetime }}</dd></div>
+    <div><dt class="inline text-slate-500">نسخه شاخص: </dt><dd class="inline">{{ card.result.run.metric_version.version|erp_number }}</dd></div>
+    <div><dt class="inline text-slate-500">مالک منبع: </dt><dd class="inline">{{ card.result.run.metric_version.definition.source_owner }}</dd></div>
+    {% if show_values and card.usable %}
+      {% for key, value in card.result.value.items %}<div class="flex flex-wrap justify-between gap-2"><dt class="text-slate-500">{% if key == 'amount' %}مبلغ{% elif key == 'quantity' %}مقدار{% elif key == 'value_amount' %}ارزش{% elif key == 'average_seconds' %}میانگین زمان (ثانیه){% elif key == 'completed_cycles' %}چرخه‌های تکمیل‌شده{% else %}{{ key }}{% endif %}</dt><dd class="font-semibold" dir="ltr">{{ value|erp_number }}</dd></div>{% endfor %}
+      <div><dt class="inline text-slate-500">واحد / ارز: </dt><dd class="inline">{% if card.result.unit == 'money' %}مبلغ{% elif card.result.unit == 'seconds' %}ثانیه{% elif card.result.unit == 'quantity_and_money' %}مقدار و ارزش{% else %}{{ card.result.unit }}{% endif %} {{ card.result.currency }}</dd></div>
+    {% endif %}
+  </dl>
+  <details class="mt-3 text-xs text-slate-500">
+    <summary class="cursor-pointer">شناسه و نسخه شواهد</summary>
+    <p class="mt-2 break-all font-mono" dir="ltr">{{ card.result.metric_code }} / {{ card.result.pk }}</p>
+    <p class="mt-1 break-all font-mono" dir="ltr">{{ card.result.run.source_watermark }}</p>
+  </details>
+  {% if card.can_drillthrough %}<a class="mt-4 inline-flex text-sm font-semibold text-blue-700" href="{% url 'reporting:drillthrough' card.result.pk %}">مشاهده شجره منبع ←</a>{% endif %}
+</article>
