+        self.assertEqual(Decimal(report["lineage_net_amount"]), Decimal("1320.00"))
+        self.assertEqual(set(report["target_reversals"]), set(inverse.fact_ids))
+        print("CEP048 CORRECTION_RECON " + json.dumps(report, sort_keys=True))
