+            {_key(x): x for x in inverse_lines},
+        )
+        if (
+            len(old_map) != len(old_lines)
+            or len(inverse_map) != len(inverse_lines)
+            or set(old_map) != set(inverse_map)
+            or original.currency != reversal.currency
