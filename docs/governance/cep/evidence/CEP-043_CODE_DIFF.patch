+                    pk=target.pk, organization=organization
+                )
+                _validate_target(draft, target)
+            rh = _canonical_hash(
+                {
+                    "draft": str(draft.pk),
+                    "reversal": str(reversal.pk),
+                    "source_hash": inverse_hash,
+                    "effective_date": str(effective_date),
+                    "reason": reason.strip(),
