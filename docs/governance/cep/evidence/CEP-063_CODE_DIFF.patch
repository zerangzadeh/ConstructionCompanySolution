diff --git a/apps/workforce/ess_timekeeping.py b/apps/workforce/ess_timekeeping.py
new file mode 100644
index 0000000..1da150b
--- /dev/null
+++ b/apps/workforce/ess_timekeeping.py
@@ -0,0 +1,262 @@
+"""Own ESS orchestration; source domains retain every state and calculation."""
+
+from datetime import date
+from zoneinfo import ZoneInfo
+
+from django.core.exceptions import PermissionDenied, ValidationError
+from django.db import transaction
+from django.utils import timezone
+
+from apps.organizations.authorization import require_business_permission, scope_queryset
+from apps.organizations.models import BusinessPermissionCode as P
+from apps.organizations.models import Organization
+from apps.timekeeping import services as source
+from apps.timekeeping.models import (
+    AttendanceCorrectionRequest,
+    AttendanceRecord,
+    LeaveMissionRequest,
+    Timesheet,
+)
+
+from . import leave_services
+from .ess_services import resolve_ess_subject
+from .leave_models import LeavePolicyVersion
+from .models import EmployeeProjectAssignment
+
+DENIED = "اطلاعات مجاز در این شرکت یافت نشد."
+SOURCES = {
+    "leave": (LeaveMissionRequest, "employee", P.LEAVE_MISSION_VIEW),
+    "attendance": (AttendanceRecord, "employee", P.ATTENDANCE_VIEW),
+    "correction": (
+        AttendanceCorrectionRequest,
+        "attendance__employee",
+        P.ATTENDANCE_VIEW,
+    ),
+    "timesheet": (Timesheet, "employee", P.TIMESHEETS_VIEW),
+}
+
+
+def subject(*, actor, organization):
+    organization = Organization.objects.get(pk=organization.pk)
+    own = resolve_ess_subject(user=actor, organization=organization)
+    if own.current_relationship.legacy_employee_id is None:
+        raise PermissionDenied(DENIED)
+    return organization, own
+
+
+def own_rows(*, actor, organization, kind):
+    organization, own = subject(actor=actor, organization=organization)
+    if kind not in SOURCES:
+        raise PermissionDenied(DENIED)
+    model, employee_field, permission = SOURCES[kind]
+    membership = require_business_permission(
+        user=actor,
+        organization=organization,
+        permission=permission,
+        message=DENIED,
+        allow_any_scope=True,
+    )
+    rows = model.objects.filter(
+        organization=organization,
+        **{employee_field: own.current_relationship.legacy_employee_id},
+    )
+    if kind == "leave":
+        rows = rows.filter(kind="leave")
+    if kind == "correction":
+        rows = rows.filter(requested_by=actor)
+    if kind != "timesheet":
+        prefix = "attendance__" if kind == "correction" else ""
+        rows = scope_queryset(
+            rows,
+            membership=membership,
+            project_lookup=prefix + "project",
+            site_lookup=prefix + "site",
+        )
+    else:
+        # Check every entry's source scope before exposing a parent timesheet.
+        visible_ids = []
+        for row in rows.prefetch_related("entries"):
+            entries = row.entries.all()
+            visible = scope_queryset(
+                entries,
+                membership=membership,
+                project_lookup="project",
+                site_lookup="site",
+            )
+            if entries.count() == visible.count():
+                visible_ids.append(row.pk)
+        rows = rows.filter(pk__in=visible_ids)
+    return rows.order_by("-created_at", "-pk")
+
+
+def own_record(*, actor, organization, kind, record_id):
+    record = (
+        own_rows(actor=actor, organization=organization, kind=kind)
+        .filter(pk=record_id)
+        .first()
+    )
+    if record is None:
+        raise PermissionDenied(DENIED)
+    return record
+
+
+def own_balances(*, actor, organization):
+    organization, own = subject(actor=actor, organization=organization)
+    today = timezone.localdate(timezone=ZoneInfo(organization.settings.timezone))
+    categories = (
+        LeavePolicyVersion.objects.filter(
+            organization=organization, effective_from__lte=today, effective_to__gt=today
+        )
+        .values_list("category_code", flat=True)
+        .distinct()
+    )
+    balances = []
+    for category in categories:
+        try:
+            balance = leave_services.balance_as_of(
+                organization=organization,
+                actor=actor,
+                relationship=own.current_relationship,
+                category_code=category,
+                as_of=today,
+            )
+        except ValidationError:
+            balances.append({"category": category, "state": "unavailable"})
+        else:
+            balances.append({"category": category, "state": "ready", "source": balance})
+    return balances
+
+
+@transaction.atomic
+def create_own_leave(
+    *, actor, organization, policy_id, starts_at, ends_at, quantity, reason
+):
+    organization = Organization.objects.select_for_update().get(pk=organization.pk)
+    organization, own = subject(actor=actor, organization=organization)
+    today = timezone.localdate(timezone=ZoneInfo(organization.settings.timezone))
+    policy = LeavePolicyVersion.objects.filter(
+        pk=policy_id, organization=organization
+    ).first()
+    if (
+        policy is None
+        or leave_services._policy(organization, policy.category_code, today).pk
+        != policy.pk
+    ):
+        raise ValidationError("سیاست مؤثر و مجاز مرخصی در دسترس نیست.")
+    request = source.create_leave_mission_request(
+        organization=organization,
+        actor=actor,
+        employee=own.current_relationship.legacy_employee,
+        kind="leave",
+        category_code=policy.category_code,
+        starts_at=starts_at,
+        ends_at=ends_at,
+        reason=reason,
+        policy_reference=policy.evidence_reference,
+    )
+    leave_services.reserve_request(
+        organization=organization,
+        actor=actor,
+        relationship=own.current_relationship,
+        request=request,
+        quantity=quantity,
+        effective_on=today,
+        source_key=f"ess-request:{request.pk}:reservation",
+        evidence_reference=f"native-request:{request.pk}",
+        reason=reason,
+        own_subject=True,
+    )
+    return request
+
+
+@transaction.atomic
+def submit_own(*, actor, organization, kind, record_id):
+    organization = Organization.objects.select_for_update().get(pk=organization.pk)
+    record = own_record(
+        actor=actor, organization=organization, kind=kind, record_id=record_id
+    )
+    if kind == "leave":
+        return source.submit_time_request(
+            organization=organization, actor=actor, request=record
+        )
+    if kind == "timesheet":
+        return source.submit_timesheet(
+            organization=organization, actor=actor, timesheet=record
+        )
+    raise PermissionDenied(DENIED)
+
+
+@transaction.atomic
+def correct_own_attendance(
+    *, actor, organization, record_id, reason, work_date, check_in_at, check_out_at
+):
+    organization = Organization.objects.select_for_update().get(pk=organization.pk)
+    attendance = own_record(
+        actor=actor, organization=organization, kind="attendance", record_id=record_id
+    )
+    return source.request_attendance_correction(
+        organization=organization,
+        requester=actor,
+        attendance=attendance,
+        reason=reason,
+        replacement_values={
+            "work_date": work_date,
+            "check_in_at": check_in_at,
+            "check_out_at": check_out_at,
+        },
+    )
+
+
+@transaction.atomic
+def create_own_timesheet(
+    *, actor, organization, period_start, period_end, declared_minutes
+):
+    organization = Organization.objects.select_for_update().get(pk=organization.pk)
+    organization, own = subject(actor=actor, organization=organization)
+    if period_start < own.current_relationship.effective_start or (
+        own.current_relationship.effective_end
+        and period_end > own.current_relationship.effective_end
+    ):
+        raise ValidationError("دوره باید در محدوده رابطه کاری باشد.")
+    return source.create_timesheet(
+        organization=organization,
+        actor=actor,
+        employee=own.current_relationship.legacy_employee,
+        period_start=period_start,
+        period_end=period_end,
+        declared_minutes=declared_minutes,
+    )
+
+
+@transaction.atomic
+def add_own_entry(
+    *, actor, organization, record_id, work_date: date, project, site, activity, minutes
+):
+    organization = Organization.objects.select_for_update().get(pk=organization.pk)
+    organization, own = subject(actor=actor, organization=organization)
+    timesheet = own_record(
+        actor=actor, organization=organization, kind="timesheet", record_id=record_id
+    )
+    assignments = EmployeeProjectAssignment.objects.filter(
+        organization=organization,
+        employee=own.current_relationship.legacy_employee,
+        project=project,
+        start_date__lte=work_date,
+    ).exclude(status="cancelled")
+    assignments = (
+        assignments.filter(site=site) if site else assignments.filter(site__isnull=True)
+    )
+    if not any(
+        row.end_date is None or row.end_date >= work_date for row in assignments
+    ):
+        raise PermissionDenied(DENIED)
+    return source.add_timesheet_entry(
+        organization=organization,
+        actor=actor,
+        timesheet=timesheet,
+        work_date=work_date,
+        project=project,
+        site=site,
+        activity=activity,
+        minutes=minutes,
+    )
diff --git a/apps/workforce/ess_timekeeping_forms.py b/apps/workforce/ess_timekeeping_forms.py
new file mode 100644
index 0000000..e407b03
--- /dev/null
+++ b/apps/workforce/ess_timekeeping_forms.py
@@ -0,0 +1,131 @@
+"""Jalali forms over source-owned choices; no Employee/tenant identity inputs."""
+
+from zoneinfo import ZoneInfo
+
+from django import forms
+from django.utils import timezone
+
+from apps.organizations.authorization import get_active_membership, scope_queryset
+from apps.projects.models import Activity, Project, ProjectSite
+from core.forms import JalaliDateMixin
+
+from .ess_timekeeping import subject
+from .leave_models import LeavePolicyVersion
+from .models import EmployeeProjectAssignment
+
+
+class ESSForm(JalaliDateMixin, forms.Form):
+    def __init__(self, *args, organization, actor, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.organization, self.own = subject(actor=actor, organization=organization)
+        for field in self.fields.values():
+            field.widget.attrs.setdefault("class", "erp-input w-full")
+
+
+class LeaveForm(ESSForm):
+    policy_id = forms.ChoiceField(label="نوع مرخصی و واحد سیاست")
+    starts_at = forms.DateTimeField(label="شروع مرخصی")
+    ends_at = forms.DateTimeField(label="پایان مرخصی")
+    quantity = forms.DecimalField(
+        label="مقدار در واحد سیاست انتخاب‌شده",
+        max_digits=14,
+        decimal_places=4,
+        min_value=0,
+    )
+    reason = forms.CharField(
+        label="دلیل درخواست", max_length=2000, widget=forms.Textarea(attrs={"rows": 3})
+    )
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        today = timezone.localdate(
+            timezone=ZoneInfo(self.organization.settings.timezone)
+        )
+        policies = LeavePolicyVersion.objects.filter(
+            organization=self.organization,
+            effective_from__lte=today,
+            effective_to__gt=today,
+        ).order_by("category_code", "-version")
+        seen = set()
+        choices = []
+        for policy in policies:
+            if policy.category_code not in seen:
+                seen.add(policy.category_code)
+                choices.append(
+                    (
+                        str(policy.pk),
+                        f"{policy.category_code} · {'دقیقه' if policy.unit == 'minutes' else 'روز'} · نسخه {policy.version}",
+                    )
+                )
+        self.fields["policy_id"].choices = choices
+
+
+class CorrectionForm(ESSForm):
+    work_date = forms.DateField(label="تاریخ پیشنهادی")
+    check_in_at = forms.DateTimeField(label="ورود پیشنهادی")
+    check_out_at = forms.DateTimeField(label="خروج پیشنهادی")
+    reason = forms.CharField(
+        label="دلیل درخواست اصلاح",
+        max_length=2000,
+        widget=forms.Textarea(attrs={"rows": 3}),
+    )
+
+    def clean(self):
+        data = super().clean()
+        if (
+            data.get("check_in_at")
+            and data.get("check_out_at")
+            and data["check_out_at"] <= data["check_in_at"]
+        ):
+            raise forms.ValidationError("خروج باید پس از ورود باشد.")
+        return data
+
+
+class TimesheetForm(ESSForm):
+    period_start = forms.DateField(label="شروع دوره")
+    period_end = forms.DateField(label="پایان دوره")
+    declared_minutes = forms.IntegerField(label="کل دقیقه اعلام‌شده", min_value=1)
+
+
+class EntryForm(ESSForm):
+    work_date = forms.DateField(label="تاریخ کارکرد")
+    project = forms.ModelChoiceField(label="پروژه", queryset=Project.objects.none())
+    site = forms.ModelChoiceField(
+        label="کارگاه", queryset=ProjectSite.objects.none(), required=False
+    )
+    activity = forms.ModelChoiceField(
+        label="فعالیت", queryset=Activity.objects.none(), required=False
+    )
+    minutes = forms.IntegerField(label="مدت به دقیقه", min_value=1)
+
+    def __init__(self, *args, organization, actor, **kwargs):
+        super().__init__(*args, organization=organization, actor=actor, **kwargs)
+        assignments = EmployeeProjectAssignment.objects.filter(
+            organization=self.organization,
+            employee=self.own.current_relationship.legacy_employee,
+        ).exclude(status="cancelled")
+        membership = get_active_membership(user=actor, organization=self.organization)
+        self.fields["project"].queryset = scope_queryset(
+            Project.objects.filter(
+                organization=self.organization, pk__in=assignments.values("project_id")
+            ),
+            membership=membership,
+            project_lookup="pk",
+            include_site_parent=True,
+        )
+        self.fields["site"].queryset = scope_queryset(
+            ProjectSite.objects.filter(
+                organization=self.organization, pk__in=assignments.values("site_id")
+            ),
+            membership=membership,
+            project_lookup="project",
+            site_lookup="pk",
+        )
+        self.fields["activity"].queryset = scope_queryset(
+            Activity.objects.filter(
+                organization=self.organization, site__in=self.fields["site"].queryset
+            ),
+            membership=membership,
+            project_lookup="project",
+            site_lookup="site",
+        )
diff --git a/apps/workforce/ess_timekeeping_views.py b/apps/workforce/ess_timekeeping_views.py
new file mode 100644
index 0000000..2d110a2
--- /dev/null
+++ b/apps/workforce/ess_timekeeping_views.py
@@ -0,0 +1,217 @@
+"""Thin own-data views; all mutations delegate to the authoritative source."""
+
+from functools import wraps
+from zoneinfo import ZoneInfo
+
+from django.core.exceptions import PermissionDenied, ValidationError
+from django.shortcuts import redirect, render
+from django.utils import timezone
+from django.views.decorators.http import require_GET, require_http_methods, require_POST
+
+from apps.organizations.authorization import require_business_permission
+from apps.organizations.decorators import active_organization_required
+from apps.organizations.models import BusinessPermissionCode as P
+
+from . import ess_timekeeping as service
+from .ess_timekeeping_forms import CorrectionForm, EntryForm, LeaveForm, TimesheetForm
+
+
+def private(view):
+    @wraps(view)
+    def wrapped(request, *args, **kwargs):
+        try:
+            return view(request, *args, **kwargs)
+        except PermissionDenied:
+            return render(request, "workforce/ess_unavailable.html", status=403)
+        except ValidationError:
+            return render(
+                request,
+                "workforce/ess_timekeeping_form.html",
+                {"error": True, "heading": "درخواست قابل انجام نیست"},
+                status=400,
+            )
+
+    return wrapped
+
+
+@active_organization_required
+@require_GET
+@private
+def index(request):
+    service.subject(actor=request.user, organization=request.organization)
+    panels = []
+    for kind, label in [
+        ("leave", "درخواست‌های مرخصی من"),
+        ("attendance", "سوابق حضور من"),
+        ("correction", "درخواست‌های اصلاح حضور من"),
+        ("timesheet", "کارکرد من"),
+    ]:
+        try:
+            rows = list(
+                service.own_rows(
+                    actor=request.user, organization=request.organization, kind=kind
+                )
+            )
+        except PermissionDenied:
+            panels.append({"kind": kind, "label": label, "state": "unavailable"})
+        else:
+            panels.append(
+                {
+                    "kind": kind,
+                    "label": label,
+                    "state": "ready" if rows else "empty",
+                    "rows": rows,
+                }
+            )
+    try:
+        balances = service.own_balances(
+            actor=request.user, organization=request.organization
+        )
+    except PermissionDenied:
+        balances = None
+    return render(
+        request,
+        "workforce/ess_timekeeping.html",
+        {"panels": panels, "balances": balances, "observed_at": timezone.now()},
+    )
+
+
+@active_organization_required
+@require_http_methods(["GET", "POST"])
+@private
+def create(request, kind):
+    forms = {
+        "leave": (LeaveForm, P.LEAVE_MISSION_REQUEST, "درخواست مرخصی"),
+        "timesheet": (TimesheetForm, P.TIMESHEETS_PREPARE, "کارکرد جدید"),
+    }
+    if kind not in forms:
+        raise PermissionDenied(service.DENIED)
+    form_type, permission, heading = forms[kind]
+    require_business_permission(
+        user=request.user,
+        organization=request.organization,
+        permission=permission,
+        message=service.DENIED,
+    )
+    service.subject(actor=request.user, organization=request.organization)
+    with timezone.override(ZoneInfo(request.organization.settings.timezone)):
+        form = form_type(
+            request.POST or None, organization=request.organization, actor=request.user
+        )
+        if request.method == "POST" and form.is_valid():
+            try:
+                record = (
+                    service.create_own_leave
+                    if kind == "leave"
+                    else service.create_own_timesheet
+                )(
+                    actor=request.user,
+                    organization=request.organization,
+                    **form.cleaned_data,
+                )
+            except ValidationError:
+                form.add_error(
+                    None,
+                    "اطلاعات درخواست با سیاست یا وضعیت منبع سازگار نیست؛ تنظیمات و مقادیر را بررسی کنید.",
+                )
+            else:
+                return redirect(
+                    "workforce:ess_timekeeping_detail", kind=kind, record_id=record.pk
+                )
+    return render(
+        request,
+        "workforce/ess_timekeeping_form.html",
+        {"form": form, "heading": heading},
+        status=400 if request.method == "POST" else 200,
+    )
+
+
+@active_organization_required
+@require_GET
+@private
+def detail(request, kind, record_id):
+    record = service.own_record(
+        actor=request.user,
+        organization=request.organization,
+        kind=kind,
+        record_id=record_id,
+    )
+    entries = record.entries.all() if kind == "timesheet" else ()
+    return render(
+        request,
+        "workforce/ess_timekeeping_detail.html",
+        {"record": record, "kind": kind, "entries": entries},
+    )
+
+
+@active_organization_required
+@require_POST
+@private
+def submit(request, kind, record_id):
+    service.submit_own(
+        actor=request.user,
+        organization=request.organization,
+        kind=kind,
+        record_id=record_id,
+    )
+    return redirect("workforce:ess_timekeeping_detail", kind=kind, record_id=record_id)
+
+
+@active_organization_required
+@require_http_methods(["GET", "POST"])
+@private
+def edit_source(request, kind, record_id):
+    if kind not in ("attendance", "timesheet"):
+        raise PermissionDenied(service.DENIED)
+    record = service.own_record(
+        actor=request.user,
+        organization=request.organization,
+        kind=kind,
+        record_id=record_id,
+    )
+    permission = P.ATTENDANCE_CORRECT if kind == "attendance" else P.TIMESHEETS_PREPARE
+    require_business_permission(
+        user=request.user,
+        organization=request.organization,
+        permission=permission,
+        message=service.DENIED,
+        project=record.project if kind == "attendance" else None,
+        site=record.site if kind == "attendance" else None,
+    )
+    form_type = CorrectionForm if kind == "attendance" else EntryForm
+    with timezone.override(ZoneInfo(request.organization.settings.timezone)):
+        form = form_type(
+            request.POST or None, organization=request.organization, actor=request.user
+        )
+        if request.method == "POST" and form.is_valid():
+            try:
+                result = (
+                    service.correct_own_attendance
+                    if kind == "attendance"
+                    else service.add_own_entry
+                )(
+                    actor=request.user,
+                    organization=request.organization,
+                    record_id=record_id,
+                    **form.cleaned_data,
+                )
+            except ValidationError:
+                form.add_error(
+                    None,
+                    "اطلاعات با وضعیت منبع سازگار نیست؛ تاریخ و مقادیر را بررسی کنید.",
+                )
+            else:
+                return redirect(
+                    "workforce:ess_timekeeping_detail",
+                    kind="correction" if kind == "attendance" else "timesheet",
+                    record_id=result.pk if kind == "attendance" else record_id,
+                )
+    return render(
+        request,
+        "workforce/ess_timekeeping_form.html",
+        {
+            "form": form,
+            "heading": "درخواست اصلاح حضور" if kind == "attendance" else "ردیف کارکرد",
+        },
+        status=400 if request.method == "POST" else 200,
+    )
