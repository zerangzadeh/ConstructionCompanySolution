-  <section class="erp-surface rounded-xl p-4"><div class="flex items-center justify-between gap-3"><h2 class="font-bold">تطبیق‌های بانکی نگهداری‌شده</h2><a class="erp-btn erp-btn--secondary" href="{% url 'treasury:statement_workbench' %}">صورت‌حساب و مغایرت بانکی</a></div><div class="overflow-x-auto"><table class="mt-3 min-w-full text-right"><caption class="sr-only">تطبیق‌های بانکی نگهداری‌شده</caption><thead><tr><th>حساب</th><th>تاریخ مبنای تطبیق</th><th>مغایرت بانکی</th></tr></thead><tbody>{% for run in bank_runs %}<tr class="border-t"><td>{{ run.account.name }}</td><td dir="ltr">{{ run.as_of_date }}</td><td>{{ run.exceptions|length }}</td></tr>{% empty %}<tr><td colspan="3" class="py-3 text-slate-500">اجرایی وجود ندارد.</td></tr>{% endfor %}</tbody></table></div></section>
-  <section class="erp-surface rounded-xl p-4"><h2 class="font-bold">بررسی مستقل تطبیق خزانه با دفترکل</h2><p class="text-sm text-slate-600">بررسی، شواهد نگهداری‌شده را امضا می‌کند و هیچ حرکت یا سند حسابداری را تغییر نمی‌دهد.</p><ul class="mt-3 divide-y">{% for run in gl_runs %}<li class="py-3"><div class="flex flex-wrap justify-between gap-2"><span>تاریخ مبنای تطبیق <bdi dir="ltr">{{ run.cutoff_date }}</bdi> · {{ run.exceptions|length }} مغایرت خزانه با حسابداری</span><bdi dir="ltr">{{ run.evidence_hash|slice:':12' }}…</bdi></div>{% if run.review %}<p class="mt-2 text-emerald-700">بررسی مستقل توسط {{ run.review.reviewed_by.user.get_full_name|default:run.review.reviewed_by.user.username }} ثبت شده است.</p>{% elif can_review_reconciliation %}<form method="post" action="{% url 'treasury:review_gl_reconciliation' run.pk %}" class="mt-2 flex flex-wrap gap-2">{% csrf_token %}<label class="sr-only" for="gl-review-{{ run.pk }}">دلیل بررسی مستقل</label><input id="gl-review-{{ run.pk }}" name="reason" required placeholder="دلیل بررسی مستقل"><button class="erp-btn erp-btn--primary">ثبت بررسی مستقل</button></form>{% endif %}</li>{% empty %}<li class="py-3 text-slate-500">اجرای خزانه به دفترکل وجود ندارد.</li>{% endfor %}</ul></section>
