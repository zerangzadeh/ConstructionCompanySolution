+    fields = (
+        "source_line_uuid",
+        "account_id",
+        "project_id",
+        "site_id",
+        "wbs_node_id",
+        "party_id",
+    )
+
+    return len(actual) == len(expected) and all(
+        all(a[k] == b[k] for k in fields)
+        and Decimal(a["debit"]) == Decimal(b["debit"])
+        and Decimal(a["credit"]) == Decimal(b["credit"])
+        for a, b in zip(actual, expected, strict=True)
