# Reviewed input template only. Inject values from an environment-scoped private
# source; production settings never load this file or checkout-local .env files.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-dedicated-random-secret
DJANGO_ALLOWED_HOSTS=replace-with-approved-hostname
DJANGO_CSRF_TRUSTED_ORIGINS=https://replace-with-approved-hostname
# Enable only behind the isolated trusted proxy that replaces forwarded scheme.
DJANGO_USE_X_FORWARDED_PROTO=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_HSTS_PRELOAD=True

DB_NAME=replace-with-approved-database
DB_USER=replace-with-least-privileged-application-role
DB_PASSWORD=replace-with-environment-secret
DB_HOST=replace-with-approved-tls-database-host
DB_PORT=5432
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/replace-with-private-ca-path/ca.crt
DB_CONNECT_TIMEOUT=10

# Dedicated absolute disjoint roots. Media/private bytes have no public proxy route.
DJANGO_STATIC_ROOT=/replace-with-release-path/static
DJANGO_MEDIA_ROOT=/replace-with-private-storage/media
DOCUMENT_PROTECTED_ROOT=/replace-with-private-storage/documents
# This backend is qualified only for the selected single-host reference.
DJANGO_CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
DJANGO_CACHE_LOCATION=/replace-with-private-storage/cache

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=replace-with-approved-smtp-host
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=replace-with-approved-smtp-account
DJANGO_EMAIL_HOST_PASSWORD=replace-with-environment-secret
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=replace-with-approved-sender

# Explicit approved Gunicorn diagnostics binding. Provision this owner-only path
# inside the governed audit/operational recovery class, outside public storage.
GUNICORN_CMD_ARGS=--config python:config.gunicorn_production
BONIRA_OPERATIONS_SINK=/replace-with-private-storage/audit-operational/diagnostics
BONIRA_OPERATIONS_ENVIRONMENT=production
